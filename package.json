{
  "name": "todo-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/api.test.mjs tests/samagra-team-e2e.mjs tests/prediction.test.mjs tests/time-machine.test.mjs tests/auth-hardening.test.mjs tests/db-foundation.test.mjs tests/migration.test.mjs tests/recurrence.test.mjs tests/settings-email.test.mjs",
    "test:db": "node scripts/test-db.mjs",
    "migrate:json": "tsx scripts/migrate-json-to-db.ts",
    "invite:create": "tsx scripts/invites.ts create",
    "invite:list": "tsx scripts/invites.ts list",
    "invite:revoke": "tsx scripts/invites.ts revoke",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
