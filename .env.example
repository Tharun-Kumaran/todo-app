# Absolute URL of the API when the frontend is hosted separately
# (for example a deployed backend). Leave unset to use same-origin `/api`.
# VITE_API_BASE_URL=http://localhost:3001

# Port the Express server listens on (defaults to 3001).
# PORT=3001

# Database. Local development defaults to an embedded PGlite database in
# server/data/pglite; production should point at a Postgres server.
# DB_DRIVER=pglite
# PGLITE_DATA_DIR=C:\path\to\pglite
# DB_DRIVER=postgres
# DATABASE_URL=postgres://user:password@host:5432/todo
# DATABASE_POOL_MAX=15

# Legacy JSON stores. Used only by `npm run migrate:json`, not by the server.
# TODO_DATA_FILE=C:\path\to\tasks.json
# TODO_USERS_FILE=C:\path\to\users.json
# TODO_TEAMS_FILE=C:\path\to\teams.json

# Invite-only beta. Generate codes with `npm run invite:create`.
# TODO_INVITE_ONLY=1
# TODO_INVITES_FILE=C:\path\to\invites.json

# Time Machine records and model state.
# TODO_TIME_MACHINE_FILE=C:\path\to\time-machine.json

# Disable in-process auth rate limiting (useful for load tests only).
# TODO_RATE_LIMIT_DISABLED=1

# Session lifetime in days (1-365).
# TODO_SESSION_DAYS=30

# Set when the API is behind a trusted reverse proxy.
# TODO_COOKIE_SAMESITE=none
# TODO_COOKIE_SECURE=1
# TODO_CORS_ORIGIN=https://your-frontend.example
