# Absolute URL of the API when the frontend is hosted separately
# (for example a deployed backend). Leave unset to use same-origin `/api`.
# VITE_API_BASE_URL=http://localhost:3001

# Port the Express server listens on (defaults to 3001).
# PORT=3001

# Override where tasks are stored (defaults to server/data/tasks.json).
# TODO_DATA_FILE=C:\path\to\tasks.json
